# Commerce-track — environment template
#
# Copy to .env.local and fill in real values. NEVER commit .env.local.
#   cp .env.example .env.local
#
# Or use the secure interactive setup (hidden input, generates the signing secret):
#   ./scripts/setup-credentials.sh
#
# All of these are server-side only. They must never reach the browser,
# never appear in source links, and never be echoed to a terminal.

# CJ Dropshipping API key — from cjdropshipping.com developer settings.
# Used to obtain the access token for product/variant and freight lookups.
CJ_API_KEY=

# SerpApi key — from serpapi.com.
# Used for Google Trends (demand momentum) and Google Shopping (pricing/competition).
SERPAPI_KEY=

# OpenAI API key — from platform.openai.com.
# Used for LLM Call 1 (goal interpretation) and Call 2 (listing generation).
# A ChatGPT subscription does not provide API access; this needs its own key.
OPENAI_API_KEY=

# Runtime model for both LLM call points. Must support structured JSON output.
# Selected after confirming availability against the API key above.
OPENAI_MODEL=

# Server-side secret used to sign short-lived product approval tokens.
# Generate locally; do not reuse a value from anywhere else.
#   openssl rand -hex 32
APP_SIGNING_SECRET=
