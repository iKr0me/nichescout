{
  "name": "nichescout",
  "version": "1.0.0",
  "private": true,
  "description": "Find products worth selling — evidence-backed niche product evaluation for ecommerce sellers.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "test:watch": "node --test --watch --experimental-strip-types tests/*.test.ts",
    "audit": "npm audit --omit=dev",
    "audit:dev": "npm audit",
    "screenshots": "./scripts/capture-screenshots.sh",
    "feasibility": "node scripts/feasibility-test.mjs",
    "env:prepare": "./scripts/prepare-env.sh",
    "env:check": "./scripts/setup-credentials.sh --check",
    "deploy:status": "./scripts/deploy.sh"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.4.20",
    "postcss": "^8.5.28",
    "tailwindcss": "3.4.15",
    "typescript": "5.7.2",
    "vercel": "^59.23.2"
  }
}
